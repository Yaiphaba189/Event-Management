# =========================================================================
# EventAI: Machine Learning Backend Config Template
# =========================================================================
# Copy this file to a new file named '.env' inside the 'ai-service/' folder:
# cp .env.example .env
#
# Replace the placeholder values below with your local configurations.
# Do NOT commit your active '.env' file containing real secrets to git.
# =========================================================================

# -------------------------------------------------------------------------
# 1. FastAPI Uvicorn Server Bindings
# -------------------------------------------------------------------------
# HOST: The network interface that Uvicorn binds to.
# - '127.0.0.1' (localhost): Standard secure local development.
# - '0.0.0.0': Listens on all interfaces (required when running inside Docker containers or on public networks).
HOST="127.0.0.1"

# PORT: The port the microservice binds to.
# Isolated to Port 8050 to avoid any port conflicts with early warning systems.
PORT=8050

# -------------------------------------------------------------------------
# 2. CORS (Cross-Origin Resource Sharing) Security Settings
# -------------------------------------------------------------------------
# ALLOWED_ORIGINS: Comma-separated list of frontends allowed to query this ML microservice.
# - In local development: http://localhost:3000 (Next.js web client).
# - In production: http://your-domain.edu or server IP addresses.
ALLOWED_ORIGINS="http://localhost:3000"

# -------------------------------------------------------------------------
# 3. Model Training & Logging Configs
# -------------------------------------------------------------------------
# DEBUG: Set to 'True' to print verbose console stacktraces and enable hot-reloading.
# Set to 'False' in production environments to lock down resource usage.
DEBUG=True
