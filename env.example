# =========================================================================
# Evently: Environment Configuration Template
# =========================================================================
# Copy this file to a new file named '.env' in the same directory:
# cp .env.example .env
#
# Replace the placeholder values below with your actual configurations.
# Do NOT commit your active '.env' file containing real secrets to git.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Prisma & PostgreSQL Database Settings
# -------------------------------------------------------------------------
# Prisma datasource connection URL.
# Supports connection strings for PostgreSQL, MySQL, SQLite, etc.
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=[SCHEMA]
#
# For standard local development (e.g., Colima/Docker/Local Postgres):
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/evently_db?schema=public"

# -------------------------------------------------------------------------
# 2. NextAuth.js Authentication Settings
# -------------------------------------------------------------------------
# NEXTAUTH_URL: The base URL where your web server is hosted.
# In local development, this is typically port 3000.
# In production, change this to your custom domain (e.g., https://evently.university.edu)
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET: Cryptographic secret key used to sign and encrypt JWT session cookies.
# ⚠️ WARNING: Always change this key to a highly secure random value in production.
# You can generate a strong cryptographically-random key using the following terminal command:
# openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_jwt_session_secret_key_change_in_production"

# -------------------------------------------------------------------------
# 3. AI Microservice Routing Configs
# -------------------------------------------------------------------------
# AI_SERVICE_URL: The endpoint address of the Python FastAPI server.
# Next.js server-side routes query this microservice for analytics.
# In local development, the microservice is isolated on Port 8050.
# If running inside a Docker network, change this to: http://ai-service:8050
AI_SERVICE_URL="http://localhost:8050"

# -------------------------------------------------------------------------
# 4. Optional: Python FastAPI Microservice Settings
# -------------------------------------------------------------------------
# These settings dictate the address and port where the FastAPI Uvicorn engine binds.
# Typically configured in 'ai-service/' scope (or passed via command terminal).
PORT=8050
HOST="127.0.0.1"
